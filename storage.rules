rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // documentos técnicos (FDS / Ficha Técnica): leitura pública,
    // escrita somente pela Cloud Function "uploadDoc" (Admin SDK, ignora estas regras)
    match /docs/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
